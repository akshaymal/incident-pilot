# LLM providers
# Default provider — Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Alternative provider — uncomment and fill in to use OpenAI instead
# OPENAI_API_KEY=your-openai-api-key-here

# Langfuse (self-hosted via docker compose)
# After running `docker compose up -d`, create a project in the Langfuse UI
# and copy the keys from Settings → API Keys.
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_HOST=http://localhost:3000
